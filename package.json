{
  "name": "pts-lazyload",
  "version": "3.0.0",
  "description": "Отложенная загрузка счётчиков и скриптов до подтверждённого взаимодействия посетителя",
  "type": "module",
  "main": "build/pts.lazyload.js",
  "files": [
    "build",
    "src"
  ],
  "scripts": {
    "dev": "vite",
    "build": "vite build && vite build --mode min",
    "site:dev": "vite --config vite.site.config.js",
    "site:build": "vite build --config vite.site.config.js",
    "test": "npm run test:unit && npm run test:e2e",
    "test:unit": "vitest run",
    "test:e2e": "npm run build && npm run site:build && playwright test"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ak-alz/pts-lazyload.git"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.64.1",
    "html-validate": "^11.18.0",
    "jsdom": "^29.1.1",
    "lightningcss": "^1.33.0",
    "sass": "^1.107.1",
    "vite": "^8.3.5",
    "vitest": "^5.1.0"
  }
}
